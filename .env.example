# Leave the key empty to run the deterministic mock. The browser never sends a key.
VULTR_API_KEY=
# Vultr's own docs also use this name. Either variable is accepted.
# VULTR_INFERENCE_API_KEY=

# OpenAI-compatible base URL.
VULTR_BASE_URL=https://api.vultrinference.com/v1

# Verified catalog id (2026-11-02): https://api.vultrinference.com/docs/models
# Unknown ids on the chat route are routed to this same default.
VULTR_MODEL=deepseek-v4.1-flash-1017

# auto | mock | live
# auto uses live only when a key is present.
SCREENING_MODE=auto

# Absolute overall-score movement that flags a blind-review shift.
FAIRNESS_SHIFT_THRESHOLD=8
